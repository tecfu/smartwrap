{
  "name": "smartwrap",
  "version": "3.0.0",
  "description": "Textwrap for javascript/nodejs. Correctly handles wide characters (宽字符) and emojis (😃). Wraps strings with option to break on words.",
  "main": "src/main.js",
  "engines": {
    "node": ">=12"
  },
  "bin": {
    "smartwrap": "src/terminal-adapter.js"
  },
  "scripts": {
    "test": "mocha test/test.js",
    "test-display": "mocha test/test.js --require test/display-hook.js",
    "lint": "eslint src/",
    "lint-fix": "eslint src/ --fix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tecfu/smartwrap.git"
  },
  "keywords": [
    "wordwrap",
    "textwrap",
    "wide-characters",
    "emoji",
    "ansi",
    "terminal"
  ],
  "author": "tecfu",
  "license": "MIT",
  "dependencies": {
    "breakword": "^1.0.5",
    "strip-ansi": "^6.0.1",
    "wcwidth": "^1.0.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "eslint": "^8.57.0",
    "mocha": "^10.7.3"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ]
}
