{
  "name": "smartwrap",
  "version": "3.0.0",
  "description": "Textwrap for javascript/nodejs. Correctly handles wide characters (宽字符) and emojis (😃). Wraps strings with option to break on words.",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "engines": {
    "node": ">=14"
  },
  "bin": {
    "smartwrap": "dist/terminal-adapter.js"
  },
  "scripts": {
    "build": "tsc",
    "pretest": "npm run build",
    "test": "mocha test/test.js",
    "test-display": "npm run build && mocha test/test.js --require test/display-hook.js",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tecfu/smartwrap.git"
  },
  "keywords": [
    "wordwrap",
    "textwrap",
    "wide-characters",
    "emoji",
    "ansi",
    "terminal",
    "typescript"
  ],
  "author": "tecfu",
  "license": "MIT",
  "dependencies": {
    "breakword": "^1.0.5",
    "strip-ansi": "^6.0.1",
    "wcwidth": "^1.0.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/strip-ansi": "^5.2.1",
    "@types/yargs": "^17.0.33",
    "chai": "^4.3.10",
    "eslint": "^8.57.0",
    "mocha": "^10.7.3",
    "typescript": "^5.4.5"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ]
}
